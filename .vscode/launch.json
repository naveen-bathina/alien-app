  "version": "0.2.0",
  "configurations": [
    {
      "name": "MyAlien (Development)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "args": [
        "--flavor",
        "development"
      ]
    },
    {
      "name": "MyAlien (Development - Profile)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main_development.dart",
      "args": [
        "--flavor",
        "development"
      ]
    },
    {
      "name": "MyAlien (Staging)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "args": [
        "--flavor",
        "staging"
      ]
    },
    {
      "name": "MyAlien (Production)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "args": [
        "--flavor",
        "production"
      ]
    },
    {
      "name": "MyAlien (Production - Release)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main_production.dart",
      "args": [
        "--flavor",
        "production"
      ]
    }
  ]
}
